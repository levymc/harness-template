{
  "name": "harness-template",
  "version": "0.1.0",
  "description": "Template de harness para projetos trabalhados com agentes de IA (NestJS + Sequelize como esqueleto).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:up": "docker compose up -d db",
    "db:migrate": "node scripts/db/migrate.mjs up",
    "db:status": "node scripts/db/migrate.mjs status",
    "harness:check": "node scripts/harness/check-claims.mjs",
    "harness:test": "node --test \"scripts/harness/test/*.test.mjs\"",
    "memory": "node scripts/harness/memory.mjs",
    "skills": "node scripts/harness/skills.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm harness:check && pnpm harness:test"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/sequelize": "12.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@types/validator": "13.15.10",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "umzug": "3.8.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
